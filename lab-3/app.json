{
  "expo": {
    "name": "Cook Book",
    "slug": "cook-book",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "cookbook",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplicația accesează galeria pentru a alege o imagine pentru rețetă."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
